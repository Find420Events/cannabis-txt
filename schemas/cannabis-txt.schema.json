{
  "$id": "https://find420.events/schemas/cannabis-txt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cannabis.txt Canonical Document",
  "description": "Validates the canonical JSON output model defined in specification/grammar.md section 10 — the object produced by the reference parser (parser/parse.ts).",
  "type": "object",
  "required": [
    "specification",
    "document",
    "metadata",
    "lists",
    "extensions",
    "sections",
    "diagnostics"
  ],
  "additionalProperties": false,
  "properties": {
    "specification": {
      "type": ["string", "null"],
      "description": "File name such as cannabis.txt or cannabis-events.txt; null when not derivable."
    },
    "document": {
      "type": "object",
      "required": ["title", "text"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": ["string", "null"] },
        "text": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Metadata-block fields under canonical keys, first-seen order. Values are strings; `unknown`/`n/a`/`-` normalize to null.",
      "properties": {
        "version": {
          "type": ["string", "null"],
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version of the published file."
        },
        "status": { "type": ["string", "null"] },
        "publisher": { "type": ["string", "null"] },
        "founding-publisher": { "type": ["string", "null"] },
        "publisher-type": { "type": ["string", "null"] },
        "canonical-url": {
          "type": ["string", "null"],
          "pattern": "^https?://",
          "description": "Absolute http(s) URL where the file is canonically served."
        },
        "canonical-project": {
          "type": ["string", "null"],
          "pattern": "^https?://"
        },
        "suggested-location": {
          "type": ["string", "null"],
          "pattern": "^https?://"
        },
        "last-updated": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO 8601 calendar date (YYYY-MM-DD)."
        },
        "published": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO 8601 calendar date (YYYY-MM-DD)."
        },
        "language": {
          "type": ["string", "null"],
          "pattern": "^[a-z]{2}(-[A-Za-z]{2,8})?$",
          "description": "BCP 47 language tag such as en or pt-BR."
        },
        "encoding": { "type": ["string", "null"] },
        "media-type": { "type": ["string", "null"] },
        "contact": { "type": ["string", "null"] },
        "website": {
          "type": ["string", "null"],
          "pattern": "^https?://"
        },
        "depends-on": { "type": ["string", "null"] }
      },
      "additionalProperties": { "type": ["string", "null"] }
    },
    "lists": {
      "type": "object",
      "description": "Block lists appearing in the metadata region.",
      "additionalProperties": {
        "type": "array",
        "items": { "type": ["string", "object", "null"] }
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "url"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Lowercase-hyphenated identifier. Level-3 conformance requires one of the recognized identifiers: events, dispensary, delivery, flower-brand, edible-brand, concentrate-brand, physician."
          },
          "url": {
            "type": "string",
            "pattern": "^https?://",
            "description": "Absolute http(s) URL; Level 3 requires it to resolve on the publisher's domain."
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["heading", "fields", "lists", "text"],
      "additionalProperties": false,
      "properties": {
        "heading": { "type": ["string", "null"] },
        "fields": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "lists": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": ["string", "object", "null"] }
          }
        },
        "text": { "type": "string" }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["level", "code", "line", "message"],
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["error", "warning", "note"] },
        "code": { "type": "string" },
        "line": { "type": "integer", "minimum": 0 },
        "message": { "type": "string" }
      }
    }
  }
}
